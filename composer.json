{
    "name": "neos/metadata",
    "description": "Data types and interfaces to manage extensible meta data for assets in Neos",
    "type": "neos-package",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "neos/media": "^8.3 || ^8.4 || ^9.0",
        "webmozart/assert": "^1 || ^2",
        "doctrine/dbal": "*"
    },
    "suggest": {
        "neos/content-repository": "^8.3"
    },
    "require-dev": {
        "neos/content-repository": "^8.3",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Neos\\MetaData\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neos\\MetaData\\Tests\\": "Tests"
        }
    },
    "scripts": {
        "test": "../../../bin/phpunit --enforce-time-limit --bootstrap ../../Libraries/autoload.php --testdox Tests",
        "test:ci": "phpunit --enforce-time-limit --bootstrap vendor/autoload.php --testdox Tests",
        "codestyle": "phpstan analyse --autoload-file ../../Libraries/autoload.php -c phpstan.neon"
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    },
    "extra": {
        "neos": {
            "package-key": "Neos.MetaData"
        }
    }
}
