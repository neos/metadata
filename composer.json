{
    "name": "neos/metadata",
    "description": "Data types and interfaces to manage extensible meta data for assets in Neos",
    "type": "neos-package",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "neos/media": "^8.3 || ^8.4 || ^9.0",
        "webmozart/assert": "^1 || ^2",
        "doctrine/dbal": "*"
    },
    "suggest": {
        "neos/content-repository": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Neos\\MetaData\\": "Classes"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Neos.MetaData"
        }
    }
}
